# ============================================================
# 99 BUILDERS & DEVELOPERS — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# PORT: Server listening port (defaults to 3000)
PORT=3000

# NODE_ENV: Set to 'production' for optimized static serving
NODE_ENV=production

# APP_URL: Canonical public domain URL (e.g. https://99builders.com)
APP_URL="https://99builders.com"

# DATA_DIR: Directory path for persistent SQLite database and uploads
DATA_DIR="./data"

# SMTP Email Dispatch (Optional: for forwarding lead notifications)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@mg.99builders.com"
# SMTP_PASS="YOUR_SMTP_PASSWORD"
# NOTIFICATION_RECIPIENT="sales@99builders.com"

# GEMINI_API_KEY: Optional AI Studio integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
